datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  INDIVIDUAL
  AGENT_TUR_OPERATOR
  CORPORATE_HR
  OPERATOR
  MANAGER
  ADMIN
}

enum UserStatus {
  PENDING_PASSWORD
  ACTIVE
  SUSPENDED
}

enum PortalType {
  INDIVIDUAL
  GROUP_AGENT
  CORPORATE
}

enum DossierStatus {
  RECEIVED
  UNDER_REVIEW
  NEEDS_CORRECTION
  SUBMITTED_TO_CONSULATE
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum DocumentStatus {
  PENDING
  VERIFIED
  NEEDS_CORRECTION
  REJECTED
}

enum AppointmentStatus {
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
  RESCHEDULED
}

enum GroupBatchStatus {
  DRAFT
  PROCESSING
  READY
  COMPLETED
}

enum WalletTxType {
  CREDIT
  DEBIT
}

enum WalletRefType {
  COMMISSION
  PAYOUT
  TOPUP
  VISA_PAYMENT
}

enum PayoutStatus {
  PENDING
  PROCESSED
  REJECTED
}

enum InvoiceStatus {
  PAID
  PENDING
  OVERDUE
}

enum VisaRecordStatus {
  ACTIVE
  EXPIRED
  PROCESSING
}

model User {
  id                      String                  @id @default(uuid())
  username                String?                 @unique
  email                   String                  @unique
  passwordHash            String?
  role                    Role                    @default(INDIVIDUAL)
  fullName                String
  phone                   String?
  companyName             String?
  preferredLanguage       String                  @default("az")
  passportNumber          String?
  passportNumberEncrypted String?                 @db.Text
  passportNumberHash      String?                 @db.VarChar(64)
  accountStatus           UserStatus              @default(PENDING_PASSWORD)
  passwordSetTokenHash    String?                 @unique @db.VarChar(64)
  passwordSetExpiresAt    DateTime?
  passwordSetAt           DateTime?
  isVerified              Boolean                 @default(false)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  dossiers                Dossier[]
  subscriptions           CorporateSubscription[]
  transactions            Transaction[]
  auditLogs               AuditLog[]
  refreshTokenSessions    RefreshTokenSession[]
  groupBatches            GroupBatch[]
  appointments            Appointment[]
  corporateEmployees      CorporateEmployee[]
  wallet                  Wallet?
  corporateInvoices       CorporateInvoice[]
}

model RefreshTokenSession {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @db.VarChar(64)
  familyId          String
  replacedByTokenId String?
  isRevoked         Boolean   @default(false)
  revokedAt         DateTime?
  revokedReason     String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  lastUsedAt        DateTime?
  ip                String?
  userAgent         String?
}

model OtpToken {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  purpose   String   @default("REGISTER")
  createdAt DateTime @default(now())
}

model Country {
  id             String         @id @default(uuid())
  code           String         @unique // e.g. HU, DE, CZ, AZ, UZ, TR
  nameAz         String
  nameEn         String
  nameRu         String
  flagUrl        String?
  isActive       Boolean        @default(true)
  visaCategories VisaCategory[]
  dossiers       Dossier[]
}

model VisaCategory {
  id               String                 @id @default(uuid())
  countryId        String
  country          Country                @relation(fields: [countryId], references: [id], onDelete: Cascade)
  code             String                 // e.g. SCHENGEN_TOURIST, WORK_PERMIT, STUDENT, ICT_TRANSFER
  nameAz           String
  nameEn           String
  nameRu           String
  baseFee          Float                  @default(80.0) // State fee
  descriptionAz    String?
  descriptionEn    String?
  descriptionRu    String?
  dynamicFields    DynamicField[]
  requiredDocTypes RequiredDocumentType[]
  dossiers         Dossier[]
}

model DynamicField {
  id             String       @id @default(uuid())
  visaCategoryId String
  visaCategory   VisaCategory @relation(fields: [visaCategoryId], references: [id], onDelete: Cascade)
  fieldName      String
  labelAz        String
  labelEn        String
  labelRu        String
  fieldType      String       // TEXT, DATE, SELECT, NUMBER
  isRequired     Boolean      @default(true)
  optionsJson    Json?
}

model RequiredDocumentType {
  id             String       @id @default(uuid())
  visaCategoryId String
  visaCategory   VisaCategory @relation(fields: [visaCategoryId], references: [id], onDelete: Cascade)
  code           String       // PASSPORT, PHOTO, FORM, BANK_STATEMENT, HOTEL_ITINERARY, INSURANCE, DIPLOMA, CONTRACT
  nameAz         String
  nameEn         String
  nameRu         String
  isRequired     Boolean      @default(true)
  allowedFormats String       @default("pdf,jpg,png")
}

model Dossier {
  id                  String                 @id @default(uuid())
  dossierNumber       String                 @unique // e.g. HU-AZ-2026-04891
  portalType          PortalType             @default(INDIVIDUAL)
  userId              String
  user                User                   @relation(fields: [userId], references: [id])
  groupBatchId        String?
  groupBatch          GroupBatch?            @relation(fields: [groupBatchId], references: [id], onDelete: SetNull)
  countryId           String
  country             Country                @relation(fields: [countryId], references: [id])
  visaCategoryId      String
  visaCategory        VisaCategory           @relation(fields: [visaCategoryId], references: [id])
  currentStep         Int                    @default(1) // 1 - 8 Addımlı Sihirbaz
  status              DossierStatus          @default(RECEIVED)
  appointmentDate     DateTime?
  appointmentLocation String?                // e.g. Budapeşt qəbul mərkəzi
  costCenter          String?
  department          String?
  governmentFee       Float                  @default(80.0)
  serviceFee          Float                  @default(120.0)
  extraServicesFee    Float                  @default(0.0)
  totalAmount         Float                  @default(200.0)
  paymentStatus       PaymentStatus          @default(PENDING)
  archivedZipUrl      String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  applicants          Applicant[]
  documents           ApplicantDocument[]
  services            AdditionalService[]
  transactions        Transaction[]
  appointments        Appointment[]
  statusHistory       DossierStatusHistory[]
}

model Applicant {
  id                      String              @id @default(uuid())
  dossierId               String
  dossier                 Dossier             @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String
  passportNumber          String
  passportNumberEncrypted String?             @db.Text
  passportNumberHash      String?             @db.VarChar(64)
  birthDate               DateTime?
  nationality             String?
  gender                  String?
  formDataJson            Json?
  documents               ApplicantDocument[]
  services                AdditionalService[]
}

model ApplicantDocument {
  id                   String         @id @default(uuid())
  dossierId            String
  dossier              Dossier        @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  applicantId          String
  applicant            Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  requiredDocumentType String
  fileUrl              String
  fileName             String
  fileSize             Int
  isMandatory          Boolean        @default(true)
  status               DocumentStatus @default(PENDING)
  operatorNotes        String?
  reviewedByUserId     String?
  reviewedAt           DateTime?
}

model AdditionalService {
  id           String     @id @default(uuid())
  dossierId    String
  dossier      Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  applicantId  String?
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  serviceType  String     // EXPRESS_PROCESSING, TRAVEL_INSURANCE, TRANSLATION_APOSTILLE, COURIER, FLIGHT_BOOKING, HOTEL_BOOKING, PREMIUM_LOUNGE, FILE_PREPARATION, etc.
  price        Float
  status       String     @default("ACTIVE")
  metadataJson Json?
  createdAt    DateTime   @default(now())
}

model Transaction {
  id                    String        @id @default(uuid())
  dossierId             String?
  dossier               Dossier?      @relation(fields: [dossierId], references: [id])
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  amount                Float
  currency              String        @default("EUR")
  paymentProvider       String        @default("STRIPE")
  stripePaymentIntentId String?
  status                PaymentStatus @default(PENDING)
  metadataJson          Json?
  createdAt             DateTime      @default(now())
}

model CorporateSubscription {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  planTier             String    // BASIC_199, PRO_499, ENTERPRISE_999
  monthlyFee           Float
  maxUsers             Int       @default(10)
  status               String    @default("ACTIVE")
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  ipAddress String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())
}

model DossierStatusHistory {
  id              String        @id @default(uuid())
  dossierId       String
  dossier         Dossier       @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  fromStatus      DossierStatus
  toStatus        DossierStatus
  changedByUserId String
  notes           String?
  createdAt       DateTime      @default(now())
}

model TimeSlot {
  id           String        @id @default(uuid())
  date         DateTime
  startTime    String        // e.g. "10:30 AM"
  capacity     Int           @default(10)
  bookedCount  Int           @default(0)
  location     String        @default("EuroTech Main Center")
  isActive     Boolean       @default(true)
  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(uuid())
  timeSlotId   String
  timeSlot     TimeSlot          @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dossierId    String?
  dossier      Dossier?          @relation(fields: [dossierId], references: [id], onDelete: SetNull)
  groupBatchId String?
  groupBatch   GroupBatch?       @relation(fields: [groupBatchId], references: [id], onDelete: SetNull)
  status       AppointmentStatus @default(CONFIRMED)
  location     String?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model GroupBatch {
  id            String             @id @default(uuid())
  code          String             @unique // e.g. GRP-8821, BCH-2026-101
  portalType    PortalType         @default(GROUP_AGENT) // GROUP_AGENT or CORPORATE
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String             // e.g. "Vienna Summer Tour", "Vienna Summit Delegation"
  destination   String             // e.g. "Hungary", "Austria", "Germany"
  travelDate    DateTime?
  duration      String?            // "short" or "long"
  projectReason String?            // "Tourism", "Business / Corporate", "Work"
  status        GroupBatchStatus   @default(DRAFT)
  dossiers      Dossier[]
  appointments  Appointment[]
  invoices      CorporateInvoice[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model CorporateEmployee {
  id                  String       @id @default(uuid())
  corporateUserId     String
  corporateUser       User         @relation(fields: [corporateUserId], references: [id], onDelete: Cascade)
  firstName           String
  lastName            String
  jobTitle            String
  department          String
  nationality         String
  passportNumber      String
  passportExpiry      DateTime?
  email               String?
  phone               String?
  delegationTokenHash String?      @unique @db.VarChar(64)
  delegationExpiresAt DateTime?
  visaHistory         VisaRecord[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
}

model VisaRecord {
  id         String            @id @default(uuid())
  employeeId String
  employee   CorporateEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  country    String
  type       String            // e.g. "Schengen C (Business)", "National D (Work)"
  issueDate  DateTime
  expiryDate DateTime
  status     VisaRecordStatus  @default(ACTIVE)
  batchRef   String?           // e.g. "BCH-2026-101"
  createdAt  DateTime          @default(now())
}

model Wallet {
  id             String              @id @default(uuid())
  userId         String              @unique
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Float               @default(0.0)
  pendingBalance Float               @default(0.0)
  currency       String              @default("EUR")
  transactions   WalletTransaction[]
  payoutRequests PayoutRequest[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model WalletTransaction {
  id            String        @id @default(uuid())
  walletId      String
  wallet        Wallet        @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Float
  type          WalletTxType
  referenceType WalletRefType
  referenceId   String?
  description   String
  status        PaymentStatus @default(PAID)
  createdAt     DateTime      @default(now())
}

model PayoutRequest {
  id          String       @id @default(uuid())
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount      Float
  bankName    String
  iban        String
  swiftBic    String
  status      PayoutStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())
}

model CorporateInvoice {
  id              String        @id @default(uuid())
  corporateUserId String
  corporateUser   User          @relation(fields: [corporateUserId], references: [id], onDelete: Cascade)
  groupBatchId    String?
  groupBatch      GroupBatch?   @relation(fields: [groupBatchId], references: [id], onDelete: SetNull)
  invoiceNumber   String        @unique // e.g. "INV-2026-9012"
  amount          Float
  dueDate         DateTime
  status          InvoiceStatus @default(PENDING)
  pdfUrl          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
